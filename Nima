local Window = Rayfield:CreateWindow({
   Name = "پنل نیما",
   LoadingTitle = "در حال بارگذاری...",
   LoadingSubtitle = "by Nima",
   ConfigurationSaving = { Enabled = false },
   KeySystem = false
