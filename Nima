local MainTab = Window:CreateTab("اسپمر اصلی", 4483362458)

local isSending = false

MainTab:CreateToggle({
   Name = "🔥 روشن / خاموش کردن اسپم پیام",
   CurrentValue = false,
   Flag = "UltraSpamToggle",
   Callback = function(Value)
      isSending = Value
      
      if isSending then
          if not sendChatRemote then
              sendChatRemote = ReplicatedStorage:FindFirstChild("SendChat", true)
          end

          if not sendChatRemote then
              Rayfield:Notify({Title = "خطا", Content = "ریموت SendChat پیدا نشد!", Duration = 3})
              return
          end

          -- اجرای موازی در چند ترد برای حداکثر سرعت ممکن
          for i = 1, 3 do
              task.spawn(function()
                  while isSending do
                      pcall(function()
                          sendChatRemote:FireServer(targetMessage)
                      end)
                      task.wait() -- اجرای آنی روی هر فریم
                  end
              end)
          end
      end
   end,
})
