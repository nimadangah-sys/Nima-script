--// Find SendChat Remote
local function FindSendChat()
    -- Try common locations
    local locations = {
        ReplicatedStorage:FindFirstChild("SendChat"),
        ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents"):FindFirstChild("SendMessage") and ReplicatedStorage.DefaultChatSystemChatEvents:FindFirstChild("SendMessage"),
        ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents"):FindFirstChild("SayMessageRequest") and ReplicatedStorage.DefaultChatSystemChatEvents:FindFirstChild("SayMessageRequest"),
        ReplicatedStorage:FindFirstChild("ChatEvents"):FindFirstChild("SendMessage"),
        ReplicatedStorage:FindFirstChild("ChatRemotes"):FindFirstChild("SendChat"),
        ReplicatedStorage:FindFirstChild("Modules"):FindFirstChild("Chat"):FindFirstChild("SendChat"),
        ReplicatedStorage:FindFirstChild("Remotes"):FindFirstChild("SendChat"),
        ReplicatedStorage:FindFirstChild("Events"):FindFirstChild("SendChat"),
        ReplicatedStorage:FindFirstChild("SendMessage"),
        ReplicatedStorage:FindFirstChild("ChatSend")
    }

    for _, remote in pairs(locations) do
        if remote and (remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction")) then
            return remote
        end
    end

    -- Search all descendants
    for _, v in pairs(ReplicatedStorage:GetDescendants()) do
        if (v:IsA("RemoteEvent") or v:IsA("RemoteFunction")) then
            local name = v.Name:lower()
            if name:find("sendchat") or name:find("sendmessage") or name:find("saymessage") or name:find("chat") then
                return v
            end
        end
    end

    return nil
end

