--// Fast Attack
task.spawn(function()
    while task.wait() do
        if S.FastAttack then
            pcall(function()
                local hrp = HRP()
                if not hrp then return end
                for _, e in pairs(GetAllEnemies()) do
                    if (e.HumanoidRootPart.Position - hrp.Position).Magnitude < 50 then
                        local tool = Char():FindFirstChildOfClass("Tool")
                        if tool then tool:Activate() end
                        task.wait(S.AttackDelay)
                        break
                    end
                end
            end)
        end
    end
end)

