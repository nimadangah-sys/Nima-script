--// Main Crusher
task.spawn(function()
    while task.wait() do
        if S.Enabled then
            pcall(function()
                if S.SpamMode then
                    for i = 1, S.ChatSpamCount do
                        if not S.Enabled then break end

                        pcall(function()
                            if S.SpamReplicatestore and SendChat then
                                if SendChat:IsA("RemoteEvent") then
                                    pcall(function() SendChat:FireServer(S.Message) end)
                                    pcall(function() SendChat:FireServer(S.Message, "All") end)
                                    pcall(function() SendChat:FireServer("All", S.Message) end)
                                elseif SendChat:IsA("RemoteFunction") then
                                    pcall(function() SendChat:InvokeServer(S.Message) end)
                                end
                            end

                            if S.SpamTextChat and TextChatRemote then
                                pcall(function() TextChatRemote:FireServer(S.Message) end)
                            end
                        end)

                        task.wait(S.Delay)
                    end
                end

                if S.CrashMode then
                    pcall(function()
                        local huge = string.rep("A", 100000)
                        if SendChat then
                            if SendChat:IsA("RemoteEvent") then
                                SendChat:FireServer(huge)
                            else
                                SendChat:InvokeServer(huge)
                            end
                        end
                    end)
                end

                if S.LagMode then
                    pcall(function()
                        for i = 1, 50 do
                            if SendChat and SendChat:IsA("RemoteEvent") then
                                SendChat:FireServer(string.rep(S.Message, 100))
                            end
                        end
                    end)
                end

                if S.KickMode then
                    pcall(function()
                        for _, p in pairs(Players:GetPlayers()) do
                            if p ~= Player then
                                pcall(function()
                                    if SendChat and SendChat:IsA("RemoteEvent") then
                                        SendChat:FireServer("/e "..string.rep("a", 10000), p.Name)
                                    end
                                end)
                            end
                        end
                    end)
                end

                if S.FloodServer then
                    pcall(function()
                        for i = 1, 20 do
                            if SendChat and SendChat:IsA("RemoteEvent") then
                                SendChat:FireServer(string.rep("💀", 5000))
                            end
                            task.wait(0.05)
                        end
                    end)
                end
            end)

            if not S.SpamLoop and not S.CrashMode and not S.LagMode and not S.KickMode and not S.FloodServer then
                S.Enabled = false
            end
        end
    end
end)

--// Fly
local flyBV, flyBG
RunService.RenderStepped:Connect(function()
    pcall(function()
        local char = Player.Character or Player.CharacterAdded:Wait()
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then return end

        if S.FlyHack then
            if not flyBV then
                flyBV = Instance.new("BodyVelocity", hrp)
                flyBV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                flyBG = Instance.new("BodyGyro", hrp)
                flyBG.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                flyBG.P = 9e4
            end
            hum.PlatformStand = true
            flyBV.Velocity = Vector3.new(0, 0, 0)
            flyBG.CFrame = workspace.CurrentCamera.CFrame
        else
            if flyBV then flyBV:Destroy() flyBV = nil end
            if flyBG then flyBG:Destroy() flyBG = nil end
            hum.PlatformStand = false
        end

        if S.NoclipHack then
            for _, p in pairs(char:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end
        end

        hum.WalkSpeed = S.SpeedValue
    end)
end)

