--// Find SendChat Remote
local function FindSendChat()
    local locations = {
        ReplicatedStorage:FindFirstChild("SendChat"),
        ReplicatedStorage:FindFirstChild("SendMessage"),
        ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents") and ReplicatedStorage.DefaultChatSystemChatEvents:FindFirstChild("SayMessageRequest"),
        ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents") and ReplicatedStorage.DefaultChatSystemChatEvents:FindFirstChild("SendMessage"),
        ReplicatedStorage:FindFirstChild("ChatEvents") and ReplicatedStorage.ChatEvents:FindFirstChild("SendMessage"),
        ReplicatedStorage:FindFirstChild("ChatRemotes") and ReplicatedStorage.ChatRemotes:FindFirstChild("SendChat"),
        ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("SendChat"),
        ReplicatedStorage:FindFirstChild("Events") and ReplicatedStorage.Events:FindFirstChild("SendChat")
    }

    for _, remote in pairs(locations) do
        if remote and (remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction")) then
            return remote
        end
    end

    for _, v in pairs(ReplicatedStorage:GetDescendants()) do
        if (v:IsA("RemoteEvent") or v:IsA("RemoteFunction")) then
            local name = v.Name:lower()
            if name:find("sendchat") or name:find("sendmessage") or name:find("saymessage") then
                return v
            end
        end
    end

    return nil
end

local SendChat = FindSendChat()
local TextChatRemote = nil

local function FindTextChatRemote()
    pcall(function()
        local channels = TextChatService:FindFirstChild("TextChannels")
        if channels then
            for _, c in pairs(channels:GetChildren()) do
                local remote = c:FindFirstChild("SendMessage") or c:FindFirstChild("OnIncomingMessage")
                if remote then
                    TextChatRemote = remote
                    return
                end
            end
        end
    end)
end

FindTextChatRemote()

